#!/usr/bin/env bash
# Prints one secret for pi's mcp.json (`!command` values).
# Order: environment variable first, then ~/.config/pi-kit/secrets.env (KEY=value lines).
# Usage: pi-kit-secret EXA_API_KEY
set -euo pipefail
name="${1:?usage: pi-kit-secret NAME}"
secrets_file="${PI_KIT_SECRETS:-$HOME/.config/pi-kit/secrets.env}"

if [[ -n "${!name:-}" ]]; then
  printf '%s' "${!name}"
  exit 0
fi

if [[ -r "$secrets_file" ]]; then
  value="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${name}=" "$secrets_file" | tail -n 1 | sed -E "s/^[[:space:]]*(export[[:space:]]+)?${name}=//; s/^[\"']//; s/[\"'][[:space:]]*$//")"
  if [[ -n "$value" ]]; then
    printf '%s' "$value"
    exit 0
  fi
fi

echo "pi-kit-secret: $name is not set (env or $secrets_file)" >&2
exit 1
