#!/usr/bin/env bash
# pi-check [--cached | --force] [COMMIT]. Validate committed files in a clean checkout.
set -euo pipefail
mode=manual
case "${1:-}" in --cached) mode=cached; shift;; --force) mode=force; shift;; esac
(( $# <= 1 )) || { echo "usage: pi-check [--cached|--force] [commit]" >&2; exit 2; }
kit="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck disable=SC1091
if [[ -f "$kit/.kit-paths" ]]; then . "$kit/.kit-paths"; export PATH="$KIT_NPM_BIN:$PATH"; fi
export PI_TEST_BRANCH=1 OPENSPEC_TELEMETRY=0
sha="$(git rev-parse --verify --end-of-options "${1:-HEAD}^{commit}")"
common="$(git rev-parse --path-format=absolute --git-common-dir)"
cache="$common/pi-check-v3"; mkdir -p "$cache"
version="$( (sha256sum < "$kit/bin/pi-check"; command -v openspec || true; node --version || true) | sha256sum | cut -d' ' -f1)"
key="$cache/$sha-$version"
exec 8>"$key.lock"; flock 8
if [[ "$mode" != force && -f "$key.ok" ]]; then echo "Local checks passed $sha (cached)"; exit 0; fi
if [[ "$mode" == cached && -f "$key.failed" ]]; then tail -n 12 "$key.failed" >&2; echo "Retry: pi-check --force $sha" >&2; exit 1; fi
tmp="$(mktemp -d)"
cleanup() { git -c core.hooksPath=/dev/null worktree remove --force "$tmp/wt" >/dev/null 2>&1 || true; rm -rf -- "$tmp"; }
trap cleanup EXIT
git -c core.hooksPath=/dev/null worktree add -q --detach "$tmp/wt" "$sha"
validate() (
	set -e
	cd "$tmp/wt"
	[[ -x scripts/check.sh ]] || { echo 'Missing executable scripts/check.sh'; exit 1; }
	[[ "$(git hash-object scripts/check.sh)" != f1233bdac1a2fd0d280470b394f3ebce4b456546 ]] || { echo 'Replace the v2 placeholder in scripts/check.sh with project checks'; exit 1; }
	./scripts/check.sh
	if [[ -f openspec/config.yaml ]]; then
		openspec validate --all --no-interactive
		shopt -s nullglob
		archived=(openspec/changes/archive/*/)
		if (( ${#archived[@]} )); then openspec validate --archived --no-interactive; fi
	fi
)
# Keep errexit active inside validate. Testing a shell function directly in an if suppresses it.
rm -f "$key.ok"
set +e
validate > "$tmp/log" 2>&1
rc=$?
set -e
if (( rc )); then mv "$tmp/log" "$key.failed"; tail -n 25 "$key.failed" >&2; echo "Local checks failed $sha (log: $key.failed)" >&2; exit "$rc"; fi
rm -f "$key.failed"; mv "$tmp/log" "$key.ok"
echo "Local checks passed $sha"
